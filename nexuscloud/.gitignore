# Go
/bin/
/dist/
*.exe
*.exe~
*.test
*.out
__debug_bin*

# Datos y runtime locales (nunca versionar contenido de usuarios)
/data/
/config.yaml
*.db
*.db-wal
*.db-shm
/backups/
/logs/

# Frontend web (Fase 2): ver también web/.gitignore, que gobierna dist/
# (una regla ahí, más específica, tiene prioridad sobre esta).
/web/node_modules/

# Cliente Flutter (Fase 3-4)
/client/build/
/client/.dart_tool/
/client/**/pubspec.lock

# Empaquetado MSIX (Fase 3 slice 11): nunca commitear una clave de firma,
# aunque sea el certificado de prueba autofirmado que genera `msix`. El
# .msix final cae dentro de /client/build/ (ya ignorado).
/client/**/*.pfx
/client/**/*.p12
/client/**/*.cer
/client/**/*.crt

# Herramientas / IDE
.vscode/
.idea/
*.iml

# Sistema operativo
.DS_Store
Thumbs.db

# Estado local de herramientas de asistencia (Claude Code, etc.)
.claude/

# Cobertura y artefactos de test
coverage.out
coverage.html
