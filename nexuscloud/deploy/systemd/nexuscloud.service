[Unit]
Description=NexusCloud - self-hosted storage platform
Documentation=https://github.com/porrii/nexuscloud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexuscloud
Group=nexuscloud
ExecStart=/usr/local/bin/nexuscloud start --config /etc/nexuscloud/config.yaml
Restart=on-failure
RestartSec=5

# Mínimo privilegio (§103) + hardening estándar de systemd. Con
# ProtectSystem=strict el resto del disco es de solo lectura: añade a
# ReadWritePaths cada ruta que NexusCloud deba poder escribir. Por defecto
# todo cuelga de storage.dataDir; si en config.yaml reubicas storageDir o
# alguna de las áreas (databaseDir, cacheDir, logsDir, backupsDir, ...) a
# otro disco, añade también esa ruta aquí.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nexuscloud
UMask=0027

# Contención de recursos por cgroup (§34, ADR-041 Decisión 0/6): cubre TODO
# el árbol de procesos, el propio servidor MÁS cada ffmpeg/pdftoppm que
# lance al generar una miniatura (thumbnails.enabled=true) -- sin esto,
# generar muchas miniaturas de vídeo a la vez podría agotar la memoria de
# la máquina entera, no solo de NexusCloud. 2 GiB/2 CPUs es un punto de
# partida razonable para uso personal/familiar con
# thumbnails.maxConcurrentGenerations en su valor por defecto (4); ajusta
# según tu hardware y carga real.
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
