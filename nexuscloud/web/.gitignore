# El contenido real de dist/ no se versiona, pero el directorio debe
# existir siempre: internal/server embebe web/dist vía go:embed (ver
# ../embed.go), que falla en tiempo de compilación si no existe.
dist/*
!dist/.gitkeep
dist-ssr
